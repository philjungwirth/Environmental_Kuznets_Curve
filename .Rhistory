min = 1991, max = 2024, value = c(1991, 2024),
step = 1, sep = "")
)
),
fluidRow(
column(
width = 12,
checkboxInput("green_bonds", "Display Green Bonds Only", FALSE)
)
)
)
server <- function(input, output) {
output$bond_chart <- renderHighchart({
df <- read_xlsx("C:/Users/philj/Downloads/Bundesanleihen_historisch.xlsx")
df <- df %>%
select(c(2,3,4,7,8,9,18,22,23,24)) %>%
rename("Name" = "Name",
"Coupon" = "Kupon / Coupon",
"Auction Date" = "Begebung / Auction Date",
"Coupon Frequency" = "Kupon-\r\nhäufigkeit /\r\nCoupon\r\nFrequency",
"Maturity" = "Fälligkeit / Maturity",
"Issue Amount in EURO" = "Begebungsvolumen / Issue Amount in EURO",
"ISIN" = "ISIN",
"Increase" = "Aufstockung / Increase",
"Funding Instrument" = "Begebungsform / Funding Instrument",
"Green Bond" = "Green Bond")
df <- df %>%
mutate(`Auction Date` = convertToDate(`Auction Date`)) %>%
mutate(Maturity = as.Date(Maturity)) %>%
mutate(Coupon = as.numeric(Coupon)) %>%
filter(`Auction Date` > as.Date("1991-01-01")) %>%
filter(year(`Auction Date`) >= input$year_range[1] &
year(`Auction Date`) <= input$year_range[2]) %>%
filter(!(input$green_bonds & `Green Bond` == "No")) %>%
mutate(Active = ifelse(Maturity < Sys.Date(), "Matured", "Outstanding")) %>%
mutate(`Issue Amount in EURO` = `Issue Amount in EURO`/ 1000000) %>%
mutate(`Issue Amount in EURO` = round(`Issue Amount in EURO`, digits = 2))
colors <- c("#931102", "#0A9302")
hc <- df %>%
hchart(
'scatter', hcaes(x = `Auction Date`,
y = Coupon,
size = `Issue Amount in EURO`,
group = Active),
maxSize = "10%",
minSize = "1%",
color = colors) %>%
hc_tooltip(
useHTML = TRUE,
pointFormat = "<b>{point.Name}</b>
<br><span style='font-size: 8px'>ISIN: {point.ISIN}</span>
<br><span style='font-size: 8px'>Issue Amount in EUR: {point.Issue Amount in EURO} Mio.</span>
<br><span style='font-size: 8px'>Coupon: {point.Coupon}%</span>
<br><span style='font-size: 8px'>Auction Date: {point.Auction Date}</span>
<br><span style='font-size: 8px'>Maturity Date: {point.Maturity}</span>
<br><span style='font-size: 8px'>Funding Instrument: {point.Funding Instrument}</span>
<br><span style='font-size: 8px'>Green Bond: {point.Green Bond}</span>") %>%
hc_title(text = "Austrian Government Bonds") %>%
hc_subtitle(text = "Since 1991") %>%
hc_yAxis(
min = 0,
title = list(text = "Coupon (%)")) %>%
hc_legend(style = list(fontSize = "5px"),
align = "left",
backgroundColor = "transparent") %>%
hc_caption(text = "<em><span style='font-size: 6px'>
Note: This chart displays only Austrian Government Bonds since 01.01.1991. Records on Bonds before that date often are ambigious in regards to the auction date.
<br>Source: https://www.oebfa.at</span></em>")
hc
})
}
